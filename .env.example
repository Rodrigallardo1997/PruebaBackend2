# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env)
# Proyecto: Sistema de Reservas de Pasajes de Buses Interurbanos (EVA-2)
# ==============================================================================

# Clave Secreta de Django (en producción usar valor seguro)
SECRET_KEY=django-insecure-eva2-buses-chile-key-2026-super-secret

# Modo Depuración (True para desarrollo, False para producción)
DEBUG=True

# Hosts Permitidos separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Configuración de Base de Datos PostgreSQL
# Motor nativo obligatorio: 'django.db.backends.postgresql'
DB_NAME=buses_chile_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Bandera para pruebas rápidas / testing unitario sin levantar PostgreSQL local
USE_SQLITE=False
